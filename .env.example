# Copie para .env e preencha localmente. Nunca versione chaves reais.
GEMINI_API_KEY=
JARVIS_MODEL=gemini-2.5-flash
JARVIS_NAME=JARVIS

# Privacidade e segurança: desativados por padrão.
JARVIS_MEMORY_ENABLED=false
JARVIS_ALLOW_SHELL=false
JARVIS_SHELL_TIMEOUT=8
JARVIS_MAX_COMMAND_LENGTH=500

# Opcional. Se vazio, usa XDG_DATA_HOME ou ~/.local/share/jarvis-assistente
# JARVIS_DATA_DIR=
